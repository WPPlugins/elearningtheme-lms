msgstr "Kurzus teljesítve"

msgid "Well done, %s."
msgstr "Szép munka, %s!"

msgid "You finished every lesson of %s. That takes patience, and it shows."
msgstr "A(z) %s minden leckéjét elvégezted. Ehhez türelem kell, és meg is látszik."

msgid "Completed"
msgstr "Teljesítve"

msgid "Someone asked to reset your password."
msgstr "Valaki új jelszót kért a fiókodhoz."

