msgstr "Üdv, %s!"

msgid "You’re now enrolled in %s. Your progress is saved as you go, so you can stop after any lesson and pick up where you left off."
msgstr "Mostantól a(z) %s kurzus résztvevője vagy. A haladásod folyamatosan mentődik, így bármelyik lecke után megállhatsz, és ott folytathatod, ahol abbahagytad."

msgid "Start the first lesson"
msgstr "Kezdd az első leckével"

msgid "Course page"
msgstr "Kurzus oldala"

msgid "Find your next course"
msgstr "Keresd meg a következő kurzusodat"

