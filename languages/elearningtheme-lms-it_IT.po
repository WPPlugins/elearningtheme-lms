msgstr "%1$d di %2$d · %3$d%%"

msgid "Reset this student’s progress? They will take every lesson and quiz again."
msgstr "Azzerare i progressi di questo studente? Dovrà rifare tutte le lezioni e i quiz."

msgid "Reset the progress of %s"
msgstr "Azzera i progressi di %s"

msgid "Reset progress"
msgstr "Azzera progressi"

msgid "Remove %s from the course"
msgstr "Rimuovi %s dal corso"

