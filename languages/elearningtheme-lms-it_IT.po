msgid_plural "%d students added to the course."
msgstr[0] "%d studente aggiunto al corso."
msgstr[1] "%d studenti aggiunti al corso."

msgid "%d new account was created; we emailed a link to set a password."
msgid_plural "%d new accounts were created; we emailed each a link to set a password."
msgstr[0] "È stato creato %d nuovo account; abbiamo inviato un link per impostare la password."
msgstr[1] "Sono stati creati %d nuovi account; a ognuno abbiamo inviato un link per impostare la password."

